    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run 8085 Mini Assembler",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/assembler",
            "args": [
                "MVI A,05H"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Build assembler"
        }
    ]
}